---
const { lang, t } = Astro.props;
---

<section class="bg-slate-950 py-16 text-white md:py-24">
  <div class="section-shell text-center" data-aos="fade-up">
    <div class="mx-auto max-w-4xl rounded-[2rem] border border-white/10 bg-gradient-to-r from-primary-700 via-primary-600 to-secondary-600 p-8 shadow-soft md:p-12">
      <h2 class="text-3xl font-bold md:text-4xl">{t("cta.title")}</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-200">{t("cta.subtitle")}</p>
      <a
        href="/contact"
        class="mt-8 inline-flex items-center gap-2 rounded-xl bg-white px-8 py-3.5 text-lg font-semibold text-primary-700 transition-all hover:-translate-y-0.5 hover:bg-slate-100"
      >
        {t("cta.button")}
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={lang === "ar" ? "M15 19l-7-7 7-7" : "M9 5l7 7-7 7"} />
        </svg>
      </a>
    </div>
  </div>
</section>

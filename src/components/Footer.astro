---
import { useTranslations, useTranslatedPath } from "../i18n/utils";

const { lang, dir } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<footer class="mt-auto bg-slate-950 text-slate-300">
  <div class="section-shell py-12 md:py-16">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-1">
        <div class="mb-4 flex items-center gap-3 text-lg font-bold text-white">
          <img src="/images/logo.jpg" alt="BesmaInfoEnergy" class="h-10 w-auto rounded-lg" />
          <span>Besma<span class="text-secondary-500">Info</span>Energy</span>
        </div>
        <p class="max-w-sm text-sm text-slate-400">{t("hero.subtitle")}</p>
        <p class="mt-3 inline-flex rounded-full border border-emerald-200/20 bg-emerald-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-emerald-300">
          Auto-Entreprise
        </p>
      </div>

      <div>
        <h3 class="mb-4 text-base font-semibold text-white">{t("nav.services")}</h3>
        <ul class="space-y-2 text-sm text-slate-300">
          <li><a href={translatePath("services")} class="hover:text-secondary-400">{t("services.it.title")}</a></li>
          <li><a href={translatePath("services")} class="hover:text-secondary-400">{t("services.energy.title")}</a></li>
          <li><a href={translatePath("portfolio")} class="hover:text-secondary-400">{t("nav.portfolio")}</a></li>
          <li><a href={translatePath("blog")} class="hover:text-secondary-400">{t("nav.blog")}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-base font-semibold text-white">{t("contact.info.title")}</h3>
        <ul class="space-y-3 text-sm text-slate-300">
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-secondary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            <a href="mailto:besmainfoenergy@gmail.com" class="hover:text-secondary-400">besmainfoenergy@gmail.com</a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-secondary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            <span dir="ltr">
              <a href="tel:+213663622010" class="block hover:text-secondary-400">+213 663 62 20 10</a>
              <a href="tel:+213559328204" class="block hover:text-secondary-400">+213 559 32 82 04</a>
            </span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-secondary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <span>Cité 372 lots, Khenchela 40000, Algérie</span>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-base font-semibold text-white">Réseaux</h3>
        <div class="flex flex-wrap gap-3">
          <a href="https://facebook.com/BesmaInfoEnergy" target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/5 text-slate-200 transition-colors hover:bg-primary-600 hover:text-white" aria-label="Facebook">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/besmainfoenergy/" target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/5 text-slate-200 transition-colors hover:bg-primary-600 hover:text-white" aria-label="LinkedIn">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://m.youtube.com/@besmainfoenergy" target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/5 text-slate-200 transition-colors hover:bg-primary-600 hover:text-white" aria-label="YouTube">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.5 6.186C0 8.07 0 12 0 12s0 3.93.5 5.814a3.016 3.016 0 002.123 2.136c1.872.505 9.377.505 9.377.505s7.505 0 9.377-.505a3.016 3.016 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="https://besmainfoenergy.github.io/" target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/5 text-slate-200 transition-colors hover:bg-primary-600 hover:text-white" aria-label="GitHub">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
          <a href="https://besma-info-energy.vercel.app/" target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/5 text-slate-200 transition-colors hover:bg-primary-600 hover:text-white" aria-label="Site web">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-800 pt-6 text-sm text-slate-400 md:flex-row">
      <p>&copy; {new Date().getFullYear()} BesmaInfoEnergy — {t("footer.rights")}</p>
      <div class="flex gap-4">
        <a href={translatePath("legal")} class="hover:text-secondary-400">{t("footer.legal")}</a>
        <a href={translatePath("privacy")} class="hover:text-secondary-400">{t("footer.privacy")}</a>
      </div>
    </div>
  </div>
</footer>

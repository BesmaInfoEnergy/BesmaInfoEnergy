---
const { lang, title, subtitle, ctaText, ctaLink, bannerSrc } = Astro.props;
const isRTL = lang === "ar";
const trustStats = [
  { value: "120+", label: lang === "fr" ? "Projets" : lang === "ar" ? "مشاريع" : "Projects" },
  { value: "98%", label: lang === "fr" ? "Satisfaction" : lang === "ar" ? "رضا" : "Satisfaction" },
  { value: "24/7", label: lang === "fr" ? "Support" : lang === "ar" ? "دعم" : "Support" },
];
---

<section class="relative overflow-hidden bg-slate-950 text-white">
  {bannerSrc && (
    <div class="absolute inset-0">
      <img src={bannerSrc} alt="" aria-hidden="true" class="h-full w-full object-cover opacity-60" />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/85 to-slate-900/60"></div>
    </div>
  )}

  <div class="absolute inset-0 opacity-25">
    <svg class="h-full w-full" viewBox="0 0 800 800" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="48" height="48" patternUnits="userSpaceOnUse">
          <path d="M 48 0 L 0 0 0 48" fill="none" stroke="white" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>
  </div>

  <div class="section-shell relative py-20 md:py-28">
    <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">
      <div class="relative max-w-3xl" data-aos="fade-up">
        <span class="eyebrow">BesmaInfoEnergy</span>
        <h1 class="mt-6 text-4xl font-black leading-tight tracking-tight md:text-5xl lg:text-6xl">
          {title}
        </h1>
        <p class="mt-6 max-w-xl text-lg text-slate-200 md:text-xl">
          {subtitle}
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          {ctaLink && ctaText && (
            <a href={ctaLink} class="btn-primary">
              {ctaText}
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={isRTL ? "M15 19l-7-7 7-7" : "M9 5l7 7-7 7"} /></svg>
            </a>
          )}
          <a href="/contact" class="btn-secondary">
            {lang === "fr" ? "Demander un devis" : lang === "ar" ? "اطلب عرض سعر" : "Request a quote"}
          </a>
        </div>

        <div class="mt-10 grid max-w-xl grid-cols-3 gap-3">
          {trustStats.map((stat) => (
            <div class="rounded-2xl border border-white/10 bg-white/5 px-3 py-4 backdrop-blur-sm">
              <div class="text-xl font-bold text-white md:text-2xl">{stat.value}</div>
              <div class="mt-1 text-[11px] uppercase tracking-[0.12em] text-slate-300">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="relative" data-aos="zoom-in" data-aos-delay="120">
        <div class="glass-panel relative overflow-hidden p-4">
          <div class="rounded-[1.5rem] border border-slate-200 bg-white p-3 shadow-soft">
            {bannerSrc && (
              <img src={bannerSrc} alt="BesmaInfoEnergy" class="h-[340px] w-full rounded-[1.2rem] object-cover" />
            )}
          </div>

          <div class="absolute -bottom-4 left-6 rounded-2xl border border-emerald-200 bg-white px-4 py-3 text-slate-800 shadow-soft">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 3" /></svg>
              </div>
              <div>
                <div class="text-xs uppercase tracking-[0.12em] text-slate-500">{lang === "fr" ? "Audit" : lang === "ar" ? "تقييم" : "Audit"}</div>
                <div class="text-sm font-semibold text-slate-900">{lang === "fr" ? "Rapport clair" : lang === "ar" ? "تقرير واضح" : "Clear report"}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-slate-50 to-transparent"></div>
</section>

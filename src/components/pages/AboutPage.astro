---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const itSkillKeys = ["about.skills.it.1", "about.skills.it.2", "about.skills.it.3", "about.skills.it.4", "about.skills.it.5", "about.skills.it.6", "about.skills.it.7"];
const energySkillKeys = ["about.skills.energy.1", "about.skills.energy.2", "about.skills.energy.3", "about.skills.energy.4", "about.skills.energy.5", "about.skills.energy.6", "about.skills.energy.7", "about.skills.energy.8"];
const expKeys = ["about.experience.1", "about.experience.2", "about.experience.3", "about.experience.4", "about.experience.5", "about.experience.6"];
const bgKeys = ["about.background.1", "about.background.2", "about.background.3"];
---

<BaseLayout
  title={t("about.title")}
  description={t("about.subtitle")}
  lang={lang}
  dir={lang === "ar" ? "rtl" : "ltr"}
>
  <section class="py-20 md:py-28">
    <div class="section-shell">
      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-soft md:p-10" data-aos="fade-up">
        <div class="grid items-center gap-10 lg:grid-cols-[1.2fr_0.8fr]">
          <div>
            <span class="inline-flex rounded-full border border-primary-200 bg-primary-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-primary-700">
              {lang === "fr" ? "À propos" : lang === "ar" ? "من نحن" : "About us"}
            </span>
            <h1 class="mt-5 text-4xl font-black tracking-tight text-slate-900 md:text-5xl">{t("about.title")}</h1>
            <p class="mt-5 max-w-2xl text-lg text-slate-600">{t("about.subtitle")}</p>
            <p class="mt-3 inline-flex rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-sm font-semibold text-emerald-700">
              {t("about.legal_status")}
            </p>

            <div class="mt-8 flex flex-wrap gap-4">
              <a href="/contact" class="btn-primary">
                {lang === "fr" ? "Nous contacter" : lang === "ar" ? "تواصل معنا" : "Contact us"}
              </a>
              <a href="/portfolio" class="btn-secondary text-slate-700 hover:text-slate-900">
                {lang === "fr" ? "Voir nos réalisations" : lang === "ar" ? "شاهد مشاريعنا" : "View our work"}
              </a>
            </div>

            <div class="mt-10 grid gap-4 sm:grid-cols-3">
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <div class="text-2xl font-black text-slate-900">120+</div>
                <div class="mt-1 text-xs uppercase tracking-[0.14em] text-slate-500">{lang === "fr" ? "Projets" : lang === "ar" ? "مشاريع" : "Projects"}</div>
              </div>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <div class="text-2xl font-black text-slate-900">98%</div>
                <div class="mt-1 text-xs uppercase tracking-[0.14em] text-slate-500">{lang === "fr" ? "Satisfaction" : lang === "ar" ? "رضا" : "Satisfaction"}</div>
              </div>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <div class="text-2xl font-black text-slate-900">24/7</div>
                <div class="mt-1 text-xs uppercase tracking-[0.14em] text-slate-500">{lang === "fr" ? "Support" : lang === "ar" ? "دعم" : "Support"}</div>
              </div>
            </div>
          </div>

          <div class="relative">
            <div class="rounded-[2rem] bg-gradient-to-br from-primary-600 via-primary-500 to-secondary-500 p-[1px] shadow-soft">
              <div class="rounded-[2rem] bg-slate-950 p-6 text-white">
                <div class="flex items-center justify-between">
                  <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl font-black text-white">B</div>
                  <div class="rounded-full border border-white/20 bg-white/5 px-3 py-1 text-[10px] uppercase tracking-[0.18em] text-slate-200">
                    {lang === "fr" ? "Expertise" : lang === "ar" ? "خبرة" : "Expertise"}
                  </div>
                </div>

                <div class="mt-8 rounded-2xl border border-white/10 bg-white/5 p-5">
                  <p class="text-sm uppercase tracking-[0.18em] text-slate-300">BesmaInfoEnergy</p>
                  <p class="mt-4 text-xl font-semibold leading-relaxed text-white">{t("about.bio")}</p>
                </div>

                <div class="mt-6 grid gap-3 sm:grid-cols-2">
                  <div class="rounded-xl border border-white/10 bg-white/5 p-3">
                    <div class="text-xs uppercase tracking-[0.12em] text-slate-300">{lang === "fr" ? "Mission" : lang === "ar" ? "رسالة" : "Mission"}</div>
                    <div class="mt-2 text-sm text-white">{lang === "fr" ? "Créer des solutions utiles et durables" : lang === "ar" ? "خلق حلول عملية ومستدامة" : "Building useful, lasting solutions"}</div>
                  </div>
                  <div class="rounded-xl border border-white/10 bg-white/5 p-3">
                    <div class="text-xs uppercase tracking-[0.12em] text-slate-300">{lang === "fr" ? "Valeur" : lang === "ar" ? "قيمة" : "Value"}</div>
                    <div class="mt-2 text-sm text-white">{lang === "fr" ? "Clarté, performance et confiance" : lang === "ar" ? "الوضوح والأداء والثقة" : "Clarity, performance and trust"}</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-16" data-aos="fade-up">
        <div class="mb-8 text-center">
          <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t("about.mission")}</h2>
        </div>
        <div class="rounded-[2rem] border border-primary-100 bg-gradient-to-r from-primary-50 via-white to-secondary-50 p-8 md:p-10">
          <p class="text-lg leading-relaxed text-slate-700">{t("about.mission.text")}</p>
        </div>
      </div>

      <div class="mt-16" data-aos="fade-up">
        <h2 class="mb-8 text-3xl font-bold text-slate-900">{t("about.skills")}</h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-soft">
            <h3 class="mb-4 flex items-center gap-2 text-xl font-bold text-primary-700">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              {t("services.it.title")}
            </h3>
            <ul class="space-y-3 text-slate-600">
              {itSkillKeys.map((key) => (
                <li class="flex items-start gap-3"><span class="mt-1 text-lg text-secondary-500">•</span><span>{t(key)}</span></li>
              ))}
            </ul>
          </div>
          <div class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-soft">
            <h3 class="mb-4 flex items-center gap-2 text-xl font-bold text-secondary-700">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              {t("services.energy.title")}
            </h3>
            <ul class="space-y-3 text-slate-600">
              {energySkillKeys.map((key) => (
                <li class="flex items-start gap-3"><span class="mt-1 text-lg text-secondary-500">•</span><span>{t(key)}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <div class="mt-16" data-aos="fade-up">
        <h2 class="mb-8 text-3xl font-bold text-slate-900">{t("about.certifications")}</h2>

        <div class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-soft">
          <h3 class="mb-4 flex items-center gap-2 text-xl font-bold text-primary-700">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            {t("about.experience.title")}
          </h3>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            {expKeys.map((key) => (
              <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4">
                <div class="h-2.5 w-2.5 shrink-0 rounded-full bg-secondary-500"></div>
                <span class="text-slate-700">{t(key)}</span>
              </div>
            ))}
          </div>

          <h3 class="mt-10 mb-4 flex items-center gap-2 text-xl font-bold text-secondary-700">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /></svg>
            {t("about.background.title")}
          </h3>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            {bgKeys.map((key) => (
              <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4">
                <div class="h-2.5 w-2.5 shrink-0 rounded-full bg-primary-500"></div>
                <span class="text-slate-700">{t(key)}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-16" data-aos="fade-up">
        <h2 class="mb-2 text-3xl font-bold text-slate-900">{t("about.links")}</h2>
        <p class="mb-8 text-sm text-slate-500">
          {lang === "fr"
            ? "Références officielles et organismes de soutien pour l’activité professionnelle."
            : lang === "ar"
              ? "مراجع رسمية ومؤسسات داعمة لنشاطنا المهني."
              : "Official references and support organizations for the professional activity."}
        </p>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <a href="https://www.anae.dz/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 rounded-[1.5rem] border border-slate-200 bg-white p-5 transition-all hover:border-primary-300 hover:shadow-soft">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-slate-100 p-2">
              <img src="/images/anae-logo.png" alt="ANAE" class="h-full w-full object-contain" />
            </div>
            <div>
              <p class="font-medium text-slate-900">ANAE</p>
              <p class="text-sm text-slate-500">{t("about.links.anae")}</p>
            </div>
          </a>
          <a href="https://moukawil.dz/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 rounded-[1.5rem] border border-slate-200 bg-white p-5 transition-all hover:border-primary-300 hover:shadow-soft">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-slate-100 p-2">
              <img src="/images/moukawil-logo.png" alt="Moukawil" class="h-full w-full object-contain" />
            </div>
            <div>
              <p class="font-medium text-slate-900">Moukawil</p>
              <p class="text-sm text-slate-500">{t("about.links.moukawil")}</p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

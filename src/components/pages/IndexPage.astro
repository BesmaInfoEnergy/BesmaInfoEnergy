---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../HeroSection.astro";
import CTASection from "../CTASection.astro";
import ServiceCard from "../ServiceCard.astro";
import WebDevPacks from "../WebDevPacks.astro";
import ProjectCard from "../ProjectCard.astro";
import TestimonialCard from "../TestimonialCard.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/utils";
import services from "../../data/services.json";
import projects from "../../data/projects.json";
import testimonials from "../../data/testimonials.json";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const whyChooseUs = [
  {
    title: lang === "fr" ? "Conseil sur mesure" : lang === "ar" ? "استشارة مخصصة" : "Tailored advice",
    text: lang === "fr" ? "Nous analysons votre besoin, votre environnement et vos objectifs pour proposer la bonne solution." : lang === "ar" ? "نحلّل احتياجك وبيئتك وأهدافك لاقتراح الحل المناسب." : "We analyze your needs, environment and goals to propose the right solution.",
  },
  {
    title: lang === "fr" ? "Exécution fiable" : lang === "ar" ? "تنفيذ موثوق" : "Reliable execution",
    text: lang === "fr" ? "Un accompagnement structuré, de la planification jusqu’au support post-livraison." : lang === "ar" ? "مرافقة منظمة من التخطيط إلى الدعم بعد التسليم." : "A structured process from planning to post-delivery support.",
  },
  {
    title: lang === "fr" ? "Vision business" : lang === "ar" ? "رؤية أعمال" : "Business vision",
    text: lang === "fr" ? "Nous alignons la technologie et l’énergie avec vos performances, votre coût et votre croissance." : lang === "ar" ? "نوازن بين التكنولوجيا والطاقة لأداءك وتكلفتك ونموك." : "We align technology and energy with your performance, cost and growth.",
  },
  {
    title: lang === "fr" ? "Suivi durable" : lang === "ar" ? "متابعة مستدامة" : "Sustainable follow-up",
    text: lang === "fr" ? "Une aide continue pour optimiser chaque solution sur le long terme." : lang === "ar" ? "مساعدة مستمرة لتحسين كل حل على المدى الطويل." : "Ongoing support to optimize every solution over the long term.",
  },
];

const process = [
  { step: "01", title: lang === "fr" ? "Diagnostic" : lang === "ar" ? "التشخيص" : "Diagnosis" },
  { step: "02", title: lang === "fr" ? "Mise en œuvre" : lang === "ar" ? "التنفيذ" : "Implementation" },
  { step: "03", title: lang === "fr" ? "Optimisation" : lang === "ar" ? "التعزيز" : "Optimization" },
];
---

<BaseLayout
  title="Accueil"
  description="Expert en informatique et énergie en Algérie. Développement web, maintenance, solaire photovoltaïque, audits énergétiques."
  lang={lang}
  dir={lang === "ar" ? "rtl" : "ltr"}
>
  <HeroSection
    lang={lang}
    title={t("hero.title")}
    subtitle={t("hero.subtitle")}
    ctaText={t("hero.cta.services")}
    ctaLink={translatePath("services")}
    contactLink={translatePath("contact")}
    contactText={lang === "fr" ? "Demander un devis" : lang === "ar" ? "اطلب عرض سعر" : "Request a quote"}
    bannerSrc="/images/hero-banner.png"
  />

  <section class="py-20 md:py-28">
    <div class="section-shell">
      <div class="grid items-start gap-10 lg:grid-cols-[0.85fr_1.15fr]">
        <div data-aos="fade-up">
          <span class="inline-flex rounded-full border border-primary-200 bg-primary-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-primary-700">
            {lang === "fr" ? "Pourquoi nous" : lang === "ar" ? "لماذا نحن" : "Why us"}
          </span>
          <h2 class="mt-5 text-3xl font-bold text-slate-900 md:text-4xl">{lang === "fr" ? "Une expertise utile, concrète et orientée résultats." : lang === "ar" ? "خبرة عملية ومفيدة وموجهة نحو النتائج." : "Practical expertise focused on results."}</h2>
          <p class="mt-5 max-w-lg text-lg text-slate-600">
            {lang === "fr"
              ? "BesmaInfoEnergy associe les compétences numériques et l’efficacité énergétique pour offrir des solutions simples, performantes et durables."
              : lang === "ar"
                ? "تجمع BesmaInfoEnergy بين الخبرة الرقمية وكفاءة الطاقة لتقديم حلول فعالة وبسيطة ومستدامة."
                : "BesmaInfoEnergy combines digital expertise and energy efficiency to deliver simple, effective and sustainable solutions."}
          </p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2" data-aos="fade-up" data-aos-delay="100">
          {whyChooseUs.map((item) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-soft">
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-primary-50 text-primary-700">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 3" /></svg>
              </div>
              <h3 class="text-lg font-semibold text-slate-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 md:py-28">
    <div class="section-shell">
      <div class="mb-12 text-center" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{lang === "fr" ? "Notre méthode" : lang === "ar" ? "أسلوبنا" : "Our method"}</h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {process.map((item, index) => (
          <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6" data-aos="fade-up" data-aos-delay={index * 70}>
            <div class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-600">{item.step}</div>
            <h3 class="mt-4 text-2xl font-bold text-slate-900">{item.title}</h3>
            <p class="mt-3 text-slate-600">
              {index === 0
                ? lang === "fr"
                  ? "Nous identifions les besoins, les vulnérabilités et les opportunités à optimiser."
                  : lang === "ar"
                    ? "نحدد الاحتياجات والثغرات والفرص التي يمكن تحسينها."
                    : "We identify needs, vulnerabilities and opportunities for optimization."
                : index === 1
                  ? lang === "fr"
                    ? "Nous mettons en place la solution avec des outils robustes et un suivi clair."
                    : lang === "ar"
                      ? "نُنفّذ الحل باستخدام أدوات قوية ومتابعة واضحة."
                      : "We implement the solution with robust tools and clear follow-up."
                  : lang === "fr"
                    ? "Nous mesurons les résultats et continuons à améliorer la performance globale."
                    : lang === "ar"
                      ? "نقيس النتائج ونستمر في تحسين الأداء العام."
                      : "We measure results and continue to improve overall performance."}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="section-shell">
      <div class="mb-16 text-center" data-aos="fade-up">
        <h2 class="mb-4 text-3xl font-bold text-slate-900 md:text-4xl">{t("section.services.title")}</h2>
        <p class="mx-auto max-w-2xl text-lg text-slate-600">{t("section.services.subtitle")}</p>
      </div>
      <div class="mb-12">
        <h3 class="mb-6 flex items-center gap-3 text-2xl font-bold text-primary-700">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          {t("section.services.it")}
        </h3>
        <div class="grid gap-6 md:grid-cols-2">
          {services.filter((s) => s.category === "it").map((service) => (
            <ServiceCard key={service.id} service={service} lang={lang} t={t} contactUrl={translatePath("contact")} />
          ))}
        </div>
        <WebDevPacks lang={lang} t={t} contactUrl={translatePath("contact")} />
      </div>
      <div>
        <h3 class="mb-6 flex items-center gap-3 text-2xl font-bold text-secondary-700">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          {t("section.services.energy")}
        </h3>
        <div class="grid gap-6 md:grid-cols-2">
          {services.filter((s) => s.category === "energy").map((service) => (
            <ServiceCard key={service.id} service={service} lang={lang} t={t} contactUrl={translatePath("contact")} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="section-shell">
      <div class="rounded-[2rem] border border-primary-100 bg-gradient-to-r from-primary-50 via-white to-secondary-50 p-8 shadow-soft md:p-10" data-aos="fade-up">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <span class="inline-flex rounded-full border border-primary-200 bg-white px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-primary-700">
              {lang === "fr" ? "Réponse rapide" : lang === "ar" ? "استجابة سريعة" : "Fast response"}
            </span>
            <h3 class="mt-4 text-2xl font-bold text-slate-900 md:text-3xl">
              {lang === "fr" ? "Besoin d’une solution sur mesure ?" : lang === "ar" ? "هل تحتاج إلى حل مخصص؟" : "Need a custom solution?"}
            </h3>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a href="tel:+213663622010" class="inline-flex items-center justify-center rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">
              {lang === "fr" ? "Appeler maintenant" : lang === "ar" ? "اتصل الآن" : "Call now"}
            </a>
            <a href={translatePath("contact")} class="inline-flex items-center justify-center rounded-full border border-primary-200 bg-white px-5 py-3 text-sm font-semibold text-primary-700 transition hover:border-primary-300 hover:bg-primary-50">
              {lang === "fr" ? "Demander un devis" : lang === "ar" ? "اطلب عرض سعر" : "Request a quote"}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 md:py-28">
    <div class="section-shell">
      <div class="mb-16 text-center" data-aos="fade-up">
        <h2 class="mb-4 text-3xl font-bold text-slate-900 md:text-4xl">{t("section.portfolio.title")}</h2>
        <p class="text-lg text-slate-600">{t("section.portfolio.subtitle")}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {projects.slice(0, 4).map((project) => (
          <ProjectCard key={project.id} project={project} lang={lang} t={t} />
        ))}
      </div>
      <div class="mt-12 text-center" data-aos="fade-up">
        <a href={translatePath("portfolio")} class="inline-flex items-center gap-2 text-base font-semibold text-primary-600 hover:text-primary-700">
          {t("section.portfolio.view")}
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={lang === "ar" ? "M15 19l-7-7 7-7" : "M9 5l7 7-7 7"} /></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="section-shell">
      <div class="mb-16 text-center" data-aos="fade-up">
        <h2 class="mb-4 text-3xl font-bold text-slate-900 md:text-4xl">{t("section.testimonials.title")}</h2>
        <p class="text-lg text-slate-600">{t("section.testimonials.subtitle")}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        {testimonials.map((t) => (
          <TestimonialCard key={t.id} testimonial={t} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <CTASection lang={lang} t={t} />
</BaseLayout>
